# Application
APP_ENV=development
APP_NAME=gemini-vision-studio
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5432/gemini_vision
SYNC_DATABASE_URL=postgresql://app:app_password@localhost:5432/gemini_vision

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
MINIO_SECURE=false

# Models
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
APP_URL=http://localhost:3000

# Auth
JWT_SECRET_KEY=change-me-in-production-32-char-min
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=10

# Budget
DAILY_BUDGET_USD=5.0
ALERT_THRESHOLD=0.8
