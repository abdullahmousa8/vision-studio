        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(job_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(job_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p95" }
