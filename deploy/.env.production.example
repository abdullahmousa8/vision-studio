# ================================================================
# Gemini Vision Studio — production environment
# Copy to repo root as `.env`, fill in REAL values, then:
#   bash deploy/init-secrets.sh
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Never commit .env or ./secrets/*.txt to version control.
# ================================================================

# ---- Domains (DNS must already point at this server) ----
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ---- PostgreSQL (keep in sync with secrets/minio too) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=gemini_vision

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ---- LLM ----
# Docker Desktop:  http://host.docker.internal:11434
# Linux host:      point at the machine running Ollama, e.g. http://192.168.1.10:11434
# In-Docker GPU:   use `docker compose ... --profile llm up` and set this to http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- App ----
APP_URL=https://example.com
CORS_ORIGINS=https://example.com
DAILY_BUDGET_USD=5.0
ALERT_THRESHOLD=0.8
RATE_LIMIT_PER_MINUTE=10

# ---- Grafana ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# ---- Backup ----
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
